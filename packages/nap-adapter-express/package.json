{
  "name": "@imani/nap-adapter-express",
  "version": "0.12.0",
  "description": "Express adapter for @imani/nap-server.",
  "keywords": [
    "nostr",
    "nap",
    "authentication",
    "nip-98"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tcheeric/nap.git",
    "directory": "packages/nap-adapter-express"
  },
  "homepage": "https://github.com/tcheeric/nap/tree/master/packages/nap-adapter-express#readme",
  "bugs": {
    "url": "https://github.com/tcheeric/nap/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
