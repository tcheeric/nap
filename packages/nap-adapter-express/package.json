    "express": "^4.21.2"
  },
  "peerDependencies": {
    "typescript": ">=5.7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0"
  },
